{
  "name": "ebay/account-management-php-sdk",
  "description": "AccountManagement PHP SDK",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "microsoft/kiota-abstractions": "^1.0",
    "microsoft/kiota-http-guzzle": "^1.0",
    "microsoft/kiota-serialization-json": "^1.0",
    "microsoft/kiota-serialization-form": "^1.0",
    "microsoft/kiota-serialization-multipart": "^1.0",
    "microsoft/kiota-serialization-text": "^1.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "EBay\\AccountManagement\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EBay\\AccountManagement\\Tests\\": "tests/"
    }
  }
}
