{
  "cases": [
    {
      "label": "empty input",
      "input": {},
      "expected": {}
    },
    {
      "label": "filter with all null fields",
      "input": {
        "filter": {
          "activeAfter": null,
          "activeBefore": null
        }
      },
      "expected": {
        "filter": {}
      }
    },
    {
      "label": "filter with values",
      "input": {
        "filter": {
          "activeAfter": "2024-01-01T00:00:00.000Z",
          "activeBefore": "2027-01-01T00:00:00.000Z"
        }
      },
      "expected": {
        "filter": {
          "activeAfter": "2024-01-01T00:00:00.000Z",
          "activeBefore": "2027-01-01T00:00:00.000Z"
        }
      }
    }
  ]
}
